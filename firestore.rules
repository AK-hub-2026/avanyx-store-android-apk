rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isPrimaryAdmin() {
      return isAuthenticated() &&
             request.auth.token.email != null &&
             (request.auth.token.email.lower() == 'alok8881864873@gmail.com' ||
              request.auth.token.email.lower() == 'akshayakshay53122@gmail.com' ||
              request.auth.token.email.lower() == 'alok.dev.360@gmail.com');
    }

    function isAdmin() {
      return isAuthenticated() && (
        isPrimaryAdmin() ||
        request.auth.token.role == 'ADMIN' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    function isDeveloper() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role == 'DEVELOPER' ||
        request.auth.token.role == 'VERIFIED_DEVELOPER' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'DEVELOPER' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'VERIFIED_DEVELOPER' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.developerStatus == 'VERIFIED'))
      );
    }

    // 1. Users collection (Private user records - readable ONLY by account owner or authorized Admins)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isPrimaryAdmin();
      
      // User creation: can create their own doc during signup, but CANNOT self-assign privileged fields
      allow create: if isPrimaryAdmin() || (
        isOwner(userId) && (
          !request.resource.data.keys().hasAny([
            'role', 'realRole', 'adminStatus', 'developerStatus', 'studentStatus', 'verificationBadge', 'verifiedDeveloper', 'isDeveloper', 'isStudent', 'verified'
          ]) ||
          (request.resource.data.role == 'USER' &&
           (!('realRole' in request.resource.data) || request.resource.data.realRole == 'USER') &&
           (!('adminStatus' in request.resource.data) || request.resource.data.adminStatus == 'NONE') &&
           (!('developerStatus' in request.resource.data) || request.resource.data.developerStatus == 'NONE' || request.resource.data.developerStatus == 'UNVERIFIED') &&
           (!('studentStatus' in request.resource.data) || request.resource.data.studentStatus == 'NONE' || request.resource.data.studentStatus == 'UNVERIFIED') &&
           (!('verificationBadge' in request.resource.data) || request.resource.data.verificationBadge == 'NONE') &&
           (!('verifiedDeveloper' in request.resource.data) || request.resource.data.verifiedDeveloper == false))
        )
      );
      
      // User update: standard user cannot self-promote to ADMIN, DEVELOPER, or grant verification badges
      allow update: if isPrimaryAdmin() || (
        isOwner(userId) && (
          isAdmin() ||
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'realRole', 'adminStatus', 'developerStatus', 'studentStatus', 'verificationBadge', 'verifiedDeveloper', 'isDeveloper', 'isStudent', 'verified', 'verificationStatus'
          ])
        )
      );
      
      // Delete: Users can delete their own account only if they are not an ADMIN. Admins cannot be self-deleted.
      allow delete: if (isOwner(userId) && (!('role' in resource.data) || resource.data.role != 'ADMIN')) || isPrimaryAdmin();
    }

    // 2. Admins collection (Authoritative admin registry - writable ONLY by Primary Admins)
    match /admins/{adminId} {
      allow read: if isPrimaryAdmin() || isAdmin();
      allow write: if isPrimaryAdmin();
    }

    // 3. Public Developer Profiles (Publicly readable, verified developer creates/updates ONLY their own matching doc)
    match /developers/{devId} {
      allow read: if true;
      allow create: if isPrimaryAdmin() || (
        isAuthenticated() &&
        isDeveloper() &&
        devId == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid &&
        (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
        (!('developerUid' in request.resource.data) || request.resource.data.developerUid == request.auth.uid) &&
        !request.resource.data.keys().hasAny([
          'verified', 'verificationBadge', 'verificationStatus', 'moderationStatus', 'adminStatus', 'status', 'reviewedBy', 'reviewedAt', 'reviewedByAdminUid'
        ])
      );
      allow update: if isPrimaryAdmin() || (
        isAuthenticated() &&
        isDeveloper() &&
        devId == request.auth.uid &&
        resource.data != null &&
        (resource.data.ownerUid == request.auth.uid || resource.data.uid == request.auth.uid || resource.data.developerUid == request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'ownerUid', 'uid', 'developerUid', 'verified', 'verificationStatus', 'verificationBadge', 'verifiedDeveloper', 'moderationStatus', 'adminStatus', 'status', 'reviewedBy', 'reviewedAt', 'reviewedByAdminUid'
        ])
      );
      allow delete: if isPrimaryAdmin();
    }

    // 3b. Developer Profiles (Alias mapping with identical strict ownership guarantees)
    match /developer_profiles/{devId} {
      allow read: if true;
      allow create: if isPrimaryAdmin() || (
        isAuthenticated() &&
        isDeveloper() &&
        devId == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid &&
        (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
        (!('developerUid' in request.resource.data) || request.resource.data.developerUid == request.auth.uid) &&
        !request.resource.data.keys().hasAny([
          'verified', 'verificationBadge', 'verificationStatus', 'moderationStatus', 'adminStatus', 'status', 'reviewedBy', 'reviewedAt', 'reviewedByAdminUid'
        ])
      );
      allow update: if isPrimaryAdmin() || (
        isAuthenticated() &&
        isDeveloper() &&
        devId == request.auth.uid &&
        resource.data != null &&
        (resource.data.ownerUid == request.auth.uid || resource.data.uid == request.auth.uid || resource.data.developerUid == request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'ownerUid', 'uid', 'developerUid', 'verified', 'verificationStatus', 'verificationBadge', 'verifiedDeveloper', 'moderationStatus', 'adminStatus', 'status', 'reviewedBy', 'reviewedAt', 'reviewedByAdminUid'
        ])
      );
      allow delete: if isPrimaryAdmin();
    }

    // 4. Developer Applications collection (Private verification documents)
    match /developer_applications/{applicationId} {
      allow read: if isPrimaryAdmin() || isAdmin() || (isAuthenticated() && (resource.data.applicantUid == request.auth.uid || resource.data.userId == request.auth.uid || applicationId == request.auth.uid));
      allow create: if isAuthenticated() &&
        applicationId == request.auth.uid &&
        (request.resource.data.applicantUid == request.auth.uid || request.resource.data.userId == request.auth.uid) &&
        (request.resource.data.status == 'PENDING_REVIEW' || request.resource.data.status == 'PENDING') &&
        !request.resource.data.keys().hasAny(['reviewedBy', 'reviewedAt', 'reviewedByAdminUid', 'reviewedByEmail', 'reviewerNotes']);
      allow update: if isPrimaryAdmin() || isAdmin() || (
        isAuthenticated() &&
        (resource.data.applicantUid == request.auth.uid || resource.data.userId == request.auth.uid || applicationId == request.auth.uid) &&
        (request.resource.data.status == 'PENDING_REVIEW' || request.resource.data.status == 'PENDING') &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewedBy', 'reviewedAt', 'reviewedByAdminUid', 'reviewedByEmail', 'reviewerNotes', 'status', 'applicantUid', 'userId'])
      );
      allow delete: if isPrimaryAdmin();
    }

    // 5. Developer Requests collection (alias)
    match /developer_requests/{requestId} {
      allow read: if isPrimaryAdmin() || isAdmin() || (isAuthenticated() && (resource.data.applicantUid == request.auth.uid || resource.data.userId == request.auth.uid || requestId == request.auth.uid));
      allow create: if isAuthenticated() &&
        requestId == request.auth.uid &&
        (request.resource.data.applicantUid == request.auth.uid || request.resource.data.userId == request.auth.uid) &&
        (request.resource.data.status == 'PENDING_REVIEW' || request.resource.data.status == 'PENDING') &&
        !request.resource.data.keys().hasAny(['reviewedBy', 'reviewedAt', 'reviewedByAdminUid', 'reviewedByEmail', 'reviewerNotes']);
      allow update: if isPrimaryAdmin() || isAdmin() || (
        isAuthenticated() &&
        (resource.data.applicantUid == request.auth.uid || resource.data.userId == request.auth.uid || requestId == request.auth.uid) &&
        (request.resource.data.status == 'PENDING_REVIEW' || request.resource.data.status == 'PENDING') &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewedBy', 'reviewedAt', 'reviewedByAdminUid', 'reviewedByEmail', 'reviewerNotes', 'status', 'applicantUid', 'userId'])
      );
      allow delete: if isPrimaryAdmin();
    }

    // 6. Student Verification Requests collection (Private student documents)
    match /student_verification_requests/{requestId} {
      allow read: if isPrimaryAdmin() || isAdmin() || (isAuthenticated() && (resource.data.applicantUid == request.auth.uid || resource.data.userId == request.auth.uid || requestId == request.auth.uid));
      allow create: if isAuthenticated() &&
        requestId == request.auth.uid &&
        (request.resource.data.applicantUid == request.auth.uid || request.resource.data.userId == request.auth.uid) &&
        (request.resource.data.status == 'PENDING_REVIEW' || request.resource.data.status == 'PENDING') &&
        !request.resource.data.keys().hasAny(['reviewedBy', 'reviewedAt', 'reviewedByAdminUid', 'reviewedByEmail', 'reviewerNotes']);
      allow update: if isPrimaryAdmin() || isAdmin() || (
        isAuthenticated() &&
        (resource.data.applicantUid == request.auth.uid || resource.data.userId == request.auth.uid || requestId == request.auth.uid) &&
        (request.resource.data.status == 'PENDING_REVIEW' || request.resource.data.status == 'PENDING') &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewedBy', 'reviewedAt', 'reviewedByAdminUid', 'reviewedByEmail', 'reviewerNotes', 'status', 'applicantUid', 'userId'])
      );
      allow delete: if isPrimaryAdmin();
    }

    // 7. Student Requests collection (alias)
    match /student_requests/{requestId} {
      allow read: if isPrimaryAdmin() || isAdmin() || (isAuthenticated() && (resource.data.applicantUid == request.auth.uid || resource.data.userId == request.auth.uid || requestId == request.auth.uid));
      allow create: if isAuthenticated() &&
        requestId == request.auth.uid &&
        (request.resource.data.applicantUid == request.auth.uid || request.resource.data.userId == request.auth.uid) &&
        (request.resource.data.status == 'PENDING_REVIEW' || request.resource.data.status == 'PENDING') &&
        !request.resource.data.keys().hasAny(['reviewedBy', 'reviewedAt', 'reviewedByAdminUid', 'reviewedByEmail', 'reviewerNotes']);
      allow update: if isPrimaryAdmin() || isAdmin() || (
        isAuthenticated() &&
        (resource.data.applicantUid == request.auth.uid || resource.data.userId == request.auth.uid || requestId == request.auth.uid) &&
        (request.resource.data.status == 'PENDING_REVIEW' || request.resource.data.status == 'PENDING') &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewedBy', 'reviewedAt', 'reviewedByAdminUid', 'reviewedByEmail', 'reviewerNotes', 'status', 'applicantUid', 'userId'])
      );
      allow delete: if isPrimaryAdmin();
    }

    // 8. Verification Requests (unified alias)
    match /verification_requests/{requestId} {
      allow read: if isPrimaryAdmin() || isAdmin() || (isAuthenticated() && (resource.data.applicantUid == request.auth.uid || resource.data.userId == request.auth.uid || requestId == request.auth.uid));
      allow create: if isAuthenticated() &&
        requestId == request.auth.uid &&
        (request.resource.data.applicantUid == request.auth.uid || request.resource.data.userId == request.auth.uid) &&
        (request.resource.data.status == 'PENDING_REVIEW' || request.resource.data.status == 'PENDING') &&
        !request.resource.data.keys().hasAny(['reviewedBy', 'reviewedAt', 'reviewedByAdminUid', 'reviewedByEmail', 'reviewerNotes']);
      allow update: if isPrimaryAdmin() || isAdmin() || (
        isAuthenticated() &&
        (resource.data.applicantUid == request.auth.uid || resource.data.userId == request.auth.uid || requestId == request.auth.uid) &&
        (request.resource.data.status == 'PENDING_REVIEW' || request.resource.data.status == 'PENDING') &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewedBy', 'reviewedAt', 'reviewedByAdminUid', 'reviewedByEmail', 'reviewerNotes', 'status', 'applicantUid', 'userId'])
      );
      allow delete: if isPrimaryAdmin();
    }

    // 9. Security Audit Logs (Strict append-only immutable audit trail created by authorized admins)
    match /audit_logs/{logId} {
      allow read: if isPrimaryAdmin() || isAdmin();
      allow create: if isPrimaryAdmin() || (
        isAdmin() && (
          request.resource.data.actorUid == request.auth.uid ||
          request.resource.data.adminUid == request.auth.uid
        )
      );
      allow update, delete: if false;
    }

    // 10. Admin Notifications (Internal alerts for moderation teams)
    match /admin_notifications/{notifId} {
      allow read, update, delete: if isPrimaryAdmin() || isAdmin();
      allow create: if isPrimaryAdmin() || isAdmin() || (
        isAuthenticated() &&
        (request.resource.data.applicantUid == request.auth.uid || request.resource.data.userId == request.auth.uid) &&
        (request.resource.data.type == 'DEVELOPER_VERIFICATION_REQUEST' ||
         request.resource.data.type == 'STUDENT_VERIFICATION_REQUEST' ||
         request.resource.data.type == 'APP_SUBMISSION') &&
        (!('status' in request.resource.data) || request.resource.data.status == 'UNREAD')
      );
    }

    // 11. Apps collection (Publicly browsable for PUBLISHED, developer reads own apps, admin reads all)
    match /apps/{appId} {
      allow read: if (resource != null && resource.data.status == 'PUBLISHED') ||
                     isAdmin() ||
                     isPrimaryAdmin() ||
                     (isAuthenticated() && resource != null && (resource.data.developerUid == request.auth.uid || resource.data.ownerUid == request.auth.uid));
      allow create: if isPrimaryAdmin() || (
        isAuthenticated() &&
        isDeveloper() &&
        (request.resource.data.developerUid == request.auth.uid || request.resource.data.ownerUid == request.auth.uid) &&
        (request.resource.data.status == 'PENDING_REVIEW' || request.resource.data.status == 'DRAFT') &&
        !request.resource.data.keys().hasAny([
          'securityScore', 'rating', 'reviewCount', 'isFeatured', 'isTrending', 'reviewedBy', 'reviewedAt', 'reviewedByAdminUid', 'moderationNotes'
        ])
      );
      allow update: if isPrimaryAdmin() || (
        isAuthenticated() &&
        isDeveloper() &&
        (resource.data.developerUid == request.auth.uid || resource.data.ownerUid == request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'ownerUid', 'developerUid', 'status', 'securityScore', 'rating', 'reviewCount', 'isFeatured', 'isTrending', 'reviewedBy', 'reviewedAt', 'reviewedByAdminUid', 'moderationNotes'
        ])
      ) || (
        // Allow developer to resubmit a draft or rejected application for review
        isAuthenticated() &&
        isDeveloper() &&
        (resource.data.developerUid == request.auth.uid || resource.data.ownerUid == request.auth.uid) &&
        (resource.data.status == 'DRAFT' || resource.data.status == 'REJECTED') &&
        request.resource.data.status == 'PENDING_REVIEW' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'ownerUid', 'developerUid', 'securityScore', 'rating', 'reviewCount', 'isFeatured', 'isTrending', 'reviewedBy', 'reviewedAt', 'reviewedByAdminUid', 'moderationNotes'
        ])
      );
      allow delete: if isPrimaryAdmin() || (isAuthenticated() && isDeveloper() && (resource.data.developerUid == request.auth.uid || resource.data.ownerUid == request.auth.uid));
    }

    // 12. App Versions collection: public read, developer/admin write
    match /app_versions/{versionId} {
      allow read: if true;
      allow create: if isPrimaryAdmin() || isAdmin() || (
        isAuthenticated() &&
        isDeveloper() &&
        request.resource.data.appId != null
      );
      allow update, delete: if isPrimaryAdmin() || isAdmin() || (
        isAuthenticated() &&
        isDeveloper() &&
        (resource == null || resource.data.developerUid == request.auth.uid || resource.data.ownerUid == request.auth.uid)
      );
    }

    // 13. Categories: public read and administrative/seed write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // 14. Featured Banners: public read and administrative/seed write
    match /featured_banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    // 15. Reviews: public read, authenticated user write own review, developers reply, admin moderate
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid) ||
                      (isAuthenticated() && isDeveloper()) ||
                      isPrimaryAdmin() ||
                      isAdmin() ||
                      // Allow reporting without requiring full admin
                      (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount', 'isReported', 'reportReason']));
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isPrimaryAdmin() || isAdmin();
    }

    // 16. Ratings: public read, authenticated user rate
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isPrimaryAdmin() || isAdmin();
    }

    // 16b. Downloads: Real application download event logs & metrics
    match /downloads/{downloadId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isPrimaryAdmin() || isAdmin();
    }

    // 16c. App Views: Real application view / impression event logs & metrics
    match /app_views/{viewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isPrimaryAdmin() || isAdmin();
    }

    // 17. Wishlist: user private wishlist
    match /wishlist/{wishlistId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isPrimaryAdmin() || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isPrimaryAdmin() || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isPrimaryAdmin() || isAdmin());
    }

    // 18. User Notifications: user private notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == 'ALL' ||
        !('userId' in resource.data) ||
        isPrimaryAdmin() ||
        isAdmin()
      );
      allow create: if isAuthenticated() || isPrimaryAdmin() || isAdmin();
      allow update, delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isPrimaryAdmin() || isAdmin();
    }

    // 19. Store Settings: public read, admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isPrimaryAdmin() || isAdmin();
    }

    // 20. AVANYX Identity - User Device Sessions (Strict Privacy: Users access only their own sessions; Admins cannot view)
    match /sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
    }

    // 21. AVANYX Identity - Connected Apps (User grants/revocations)
    match /connected_apps/{appId} {
      allow read: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
    }

    // 22. AVANYX Identity - OAuth Clients (Admin managed client registry)
    match /oauth_clients/{clientId} {
      allow read: if isAuthenticated();
      allow create: if isPrimaryAdmin() || isAdmin();
      allow update, delete: if isPrimaryAdmin() || isAdmin();
    }
  }
}
